# Copy to .env to override defaults. Never commit .env.
# Every value below is optional — the app runs with these defaults.

# --- Product source ---
PRODUCT_SOURCE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300

# --- Merchandising ---
# The 5 products the business has chosen as "top rated" for the home page (in display order).
FEATURED_PRODUCT_IDS=1,5,9,13,18
# How many products are highlighted as "top rated" on each category page.
TOP_RATED_PER_CATEGORY=3

# --- Email ---
# Locally these point at Mailpit (docker compose) — no real email is sent.
# For production, e.g. Amazon SES SMTP: SMTP_HOST=email-smtp.eu-west-2.amazonaws.com SMTP_PORT=465 SMTP_SECURE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Catalogue <no-reply@catalogue.local>
SALES_INBOX=sales@catalogue.local

# --- Security ---
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=

# --- Host ports (docker compose only) ---
WEB_PORT=8080
API_PORT=4000
MAILPIT_UI_PORT=8025
